# Warpzone server from an official release binary: small and quick to build.
#   docker compose build      (WARPZONE_VERSION / WARPZONE_SHA256 come from .env)
FROM alpine:3.22
ARG WARPZONE_VERSION
ARG WARPZONE_SHA256
ARG WARPZONE_REPO=jarvis-jhk/warpzone
RUN apk add --no-cache wget \
 && wget -qO /usr/local/bin/warpzone-server \
      "https://github.com/${WARPZONE_REPO}/releases/download/v${WARPZONE_VERSION}/warpzone-server-${WARPZONE_VERSION}-x86_64-linux-musl" \
 && echo "${WARPZONE_SHA256}  /usr/local/bin/warpzone-server" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/warpzone-server \
 && adduser -D -H -u 10001 warpzone
USER 10001
ENTRYPOINT ["/usr/local/bin/warpzone-server", "--config", "/config/server.toml"]
